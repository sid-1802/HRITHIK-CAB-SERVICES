rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sidlok1.sl@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /sharedData/{documentId} {
      allow read: if documentId in ['services', 'vehicles', 'settings'];
      allow read, write: if isAdmin();
    }
  }
}
